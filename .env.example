# Copy to .env and restart:  cp .env.example .env

PORT=3000
CACHE_DIR=cache
YTDLP_COOKIES=cookies.txt
YTDLP_COOKIES_FROM_BROWSER=chrome

# Timeouts (ms)
SEARCH_TIMEOUT_MS=45000
SEARCH_RESULT_LIMIT=10
DOWNLOAD_TIMEOUT_MS=180000
PITCH_TIMEOUT_MS=180000

# Pitch
PITCH_LIMIT=12
PREFETCH_PITCH_MIN=-3
PREFETCH_PITCH_MAX=3
PITCH_RENDER_CONCURRENCY=4
PITCH_AUDIO_BITRATE=192k
SHIFT_OUTPUT_GAIN=0.8